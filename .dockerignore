# VCS / IDE
.git
.vscode
.idea

# Secrets - never bake env files into an image
.env
.env.*
**/.env
**/.env.*

# Dependencies & build output - installed/built inside Docker.
# (Required: without this, `COPY . .` would overwrite the Linux
# node_modules staged in the deps layer with Windows host copies.)
**/node_modules
**/dist
**/.next
**/.turbo
**/coverage
**/*.tsbuildinfo
**/.deploy-hash

# Logs & temp
*.log
**/tmp
**/temp

# Docker config - not needed inside images
**/Dockerfile
docker-compose*.yml
.dockerignore

# Misc local files
**/AGENTS.md
start.ps1
