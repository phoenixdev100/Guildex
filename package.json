{
  "name": "discord-bot-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready Discord bot platform with secure web dashboard",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "stop": "node scripts/kill-ports.mjs",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "db:generate": "pnpm --filter @discord-platform/database db:generate",
    "db:migrate": "pnpm --filter @discord-platform/database db:migrate",
    "db:studio": "pnpm --filter @discord-platform/database db:studio"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "turbo": "^2.11.7",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0",
  "pnpm": {
    "overrides": {
      "undici": "6.28.1",
      "fast-uri@2": "^2.4.7",
      "fast-uri@3": "^3.1.8",
      "minimatch@3": "^3.1.5",
      "brace-expansion@1": "^1.1.21",
      "brace-expansion@2": "^2.1.7",
      "nanoid@3": "^3.3.19",
      "picomatch@2": "^2.3.2",
      "picomatch@4": "^4.0.7",
      "js-yaml@4": "^4.3.2",
      "bn.js@4": "^4.12.5",
      "browserslist": "^4.29.1",
      "postcss": "^8.5.28",
      "postcss-selector-parser@6": "^6.1.4",
      "flatted": "^3.4.4",
      "ws@8": "^8.21.3",
      "lodash": "^4.18.1",
      "@fastify/static": "^10.1.2",
      "ajv@8": "^8.18.0",
      "yaml@2": "^2.8.3"
    }
  }
}
